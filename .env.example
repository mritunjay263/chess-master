# Copy this to .env and fill in your values
# When using Expo tunnel, set this to your tunnel URL (e.g. https://xxxx.exp.direct)
# When running locally on device via LAN, set to your machine's LAN IP
# When using Android emulator locally, set to http://10.0.2.2:3001
# When using iOS simulator locally, set to http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
