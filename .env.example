# ─── Expo tunnel setup ────────────────────────────────────────────────────────
# 1. Run: npx expo start --tunnel --clear
# 2. Copy the tunnel URL shown in terminal (looks like https://xxxx.exp.direct)
# 3. Paste it below and save, then restart Expo
#
# ─── LAN setup (physical device, same WiFi) ──────────────────────────────────
# Set to your machine's LAN IP, e.g. http://192.168.1.10:3001
# Find it with: ipconfig (Windows) or ifconfig / ip addr (Mac/Linux)
#
# ─── Simulator/emulator ──────────────────────────────────────────────────────
# Android emulator : http://10.0.2.2:3001   (leave EXPO_PUBLIC_API_URL blank)
# iOS simulator    : http://localhost:3001   (leave EXPO_PUBLIC_API_URL blank)

EXPO_PUBLIC_API_URL=https://YOUR-TUNNEL-URL.exp.direct
